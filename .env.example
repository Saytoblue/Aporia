# ──────────────────────────────────────────────
# Aporia — Environment Configuration
# Copy to .env and fill in your values
# ──────────────────────────────────────────────

# ── LLM Provider (default: deepseek) ─────────
# Supported: deepseek | gemini | openai | anthropic
RESEARCH_AGENT_LLM_PROVIDER=deepseek

# ── DeepSeek (default provider) ───────────────
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_BASE_URL=https://api.deepseek.com

# ── Gemini (optional) ─────────────────────────
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-1.5-flash

# ── OpenAI (optional) ─────────────────────────
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o
# OPENAI_API_BASE=

# ── Anthropic (optional) ──────────────────────
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-6

# ── Ollama (optional, local) ──────────────────
# OLLAMA_MODEL=llama3

# ── Semantic Scholar API (optional) ───────────
# Increases rate limit; get a key at:
# https://www.semanticscholar.org/product/api#api-key-form
# SEMANTIC_SCHOLAR_API_KEY=
# S2_API_KEY=

# ── Paper search tuning ───────────────────────
# RESEARCH_AGENT_PAPER_MIN=12
# RESEARCH_AGENT_PAPER_LIMIT=60
# RESEARCH_AGENT_RERANK_CANDIDATES=30

# ── PDF auto-read (optional) ──────────────────
# Set to 1 to auto-download and extract PDFs during search
# RESEARCH_AGENT_AUTO_READ_PDF=1
# RESEARCH_AGENT_AUTO_READ_PDF_MAX=4
# RESEARCH_AGENT_PDF_MAX_PAGES=12
# RESEARCH_AGENT_PDF_MAX_CHARS=30000
# RESEARCH_AGENT_CACHE_DIR=.research_agent_cache

# ── Gemini model fallback (optional) ──────────
# RESEARCH_AGENT_GEMINI_ALLOW_MODEL_FALLBACK=1
# RESEARCH_AGENT_GEMINI_FALLBACK_MODELS=gemini-2.5-flash,gemini-2.0-flash,gemini-1.5-flash

# ── LLM retry (optional) ──────────────────────
# RESEARCH_AGENT_LLM_RETRY_MAX=2

# ── Persistent storage (optional) ─────────────
# DATABASE_URL=sqlite:///aporia_sessions.db
